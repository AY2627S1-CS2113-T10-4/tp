@startuml
!pragma layout smetana

title UniEnable architecture
top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam componentStyle rectangle
skinparam componentBackgroundColor #EDF3F8
skinparam componentBorderColor #526477
skinparam ArrowColor #526477
skinparam nodesep 35
skinparam ranksep 45

component "Console bootstrap\nUniEnable\nConsoleHelper" as Console
component "Console UI\nUi" as UI
component "Parsing\nParser\nFeature parsers" as Parsing
component "Commands\nCommand subclasses\nCommandResult" as Commands
component "Storage\nStorage\nFacilityStorage / ConnectionStorage\nLoadResult<T>" as Storage
component "Accessibility logic\nFacilityManager / ConnectionManager\nDijkstraShortestPath / DijkstraSolver" as Accessibility
component "Models\nActivityList / Activity\nFacility / FacilityFeature / Connection" as Models

Console ..> UI : read / display
Console ..> Parsing : parse input
Console ..> Commands : execute
Console ..> Storage : load / save
Parsing ..> Commands : create
Commands ..> Models : read / update activities
Commands ..> Accessibility : query
Accessibility ..> Models : read reference data
Storage ..> Models : load records / save activities

legend bottom
  Boxes group related classes.
  Dashed arrows show selected dependencies.
endlegend
@enduml
