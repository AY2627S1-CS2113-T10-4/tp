@startuml
!pragma layout smetana
title Conditional activity persistence
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
skinparam ArrowColor #526477
hide empty members

class ConsoleHelper <<utility>> {
  {static} ~processNextCommand(...): boolean
}
class CommandResult {
  -message: String
  -isExit: boolean
  -didChangeActivities: boolean
  +didChangeActivities(): boolean
}
class Storage {
  -activityFile: Path
  -warnings: List<String>
  -loadedCorruptData: boolean
  +load(): ActivityList
  +getWarnings(): List<String>
  +save(activities: ActivityList): void
  -backupCorruptFile(): void
  -moveIntoPlace(temporaryFile: Path): void
}
class ActivityList {
  +getByDisplayedIndex(displayedIndex: int): Activity
  +setDoneAtDisplayedIndex(...): boolean
  +getActivities(): List<Activity>
}
class Activity {
  +isDone(): boolean
  +setDone(isDone: boolean): void
}

ConsoleHelper ..> CommandResult : reads change flag
ConsoleHelper ..> Storage : saves on change
Storage ..> ActivityList : restores / serialises
ActivityList --> "0..*" Activity : activities

note bottom of CommandResult
  MarkCommand and UnmarkCommand set the
  flag from setDoneAtDisplayedIndex(...).
end note
@enduml
