'@@author Oliver-koh
@startuml
title Mark an activity as incomplete
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #526477
skinparam ParticipantBackgroundColor #EDF3F8
skinparam ParticipantBorderColor #526477
skinparam sequenceMessageAlign center
hide footbox

participant "ConsoleHelper" as Console
participant "parser:Parser" as Parser
participant "command:UnmarkCommand" as Query
participant "activities:ActivityList" as Activities
participant "activity:Activity" as Activity
participant "storage:Storage" as Storage
participant "ui:Ui" as UI

note over Console, Query
  The parser creates UnmarkCommand(1).
end note
Console -> Parser : parse("unmark 1")
Parser --> Console : command
Console -> Query : execute(activities, storage)
Query -> Activities : getByDisplayedIndex(1)
Activities --> Query : activity
Query -> Activities : setDoneAtDisplayedIndex(1, false)
Activities -> Activities : getByDisplayedIndex(1)
Activities -> Activity : isDone()
Activity --> Activities : current completion
alt completion already equals false
  Activities --> Query : changed = false
else completion differs
  Activities -> Activity : setDone(false)
  Activities --> Query : changed = true
end
Query --> Console : CommandResult(message, false, changed)
opt result.didChangeActivities()
  Console -> Storage : markUnsavedChanges()
  Console -> Storage : save(activities)
  alt save succeeds
    Storage --> Console : saved
  else save fails
    Storage --> Console : throws UniEnableException
    Console -> UI : showMessage(save error)
    Console -> UI : showMessage(persistent unsaved warning)
  end
end
opt no save failure
  Console -> UI : showMessage(result.getMessage())
  Console -> Storage : hasUnsavedChanges()
  Storage --> Console : status
  opt unsaved changes remain
    Console -> UI : showMessage(persistent unsaved warning)
  end
end
note over Console, UI
  No change returns an already-in-that-state warning.
  Invalid syntax or indexes are displayed as warnings without saving.
  ConsoleHelper owns save handling; see CompletionAndSaveSequence.
end note
@enduml
'@@author
