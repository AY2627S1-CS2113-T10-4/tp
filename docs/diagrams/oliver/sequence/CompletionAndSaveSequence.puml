'@@author Oliver-koh
@startuml
title Mark an activity and save if changed
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ParticipantBackgroundColor #EDF3F8
skinparam ParticipantBorderColor #526477
skinparam ArrowColor #526477
skinparam sequenceMessageAlign center
hide footbox

actor "User" as User
participant "ui:Ui" as UI
participant "ConsoleHelper" as Console
participant ":MarkCommand" as Mark
participant "activities:ActivityList" as Activities
participant "storage:Storage" as Storage

Console -> UI : readLine()
User -> UI : mark 1
UI --> Console : input

note over Console, Mark
  Parser has already created MarkCommand(1).
end note
Console -> Mark : execute(activities, storage)
activate Mark
Mark -> Activities : getByDisplayedIndex(1)
activate Activities
Activities --> Mark : selected activity
deactivate Activities
Mark -> Activities : setDoneAtDisplayedIndex(1, true)
activate Activities
note right of Activities
  Resolve the canonical index again.
  Return false if already done;
  otherwise set done and return true.
end note
Activities --> Mark : changed
deactivate Activities
Mark --> Console : result
deactivate Mark

opt result.didChangeActivities()
  Console -> Storage : markUnsavedChanges()
  Console -> Storage : save(activities)
  activate Storage
  opt loadedCorruptData and file exists
    Storage -> Storage : backupCorruptFile()
    note right of Storage
      Copy the original bytes and verify
      the .corrupt.bak file before writing.
    end note
  end
  Storage -> Activities : getActivities()
  activate Activities
  Activities --> Storage : insertion-order snapshot
  deactivate Activities
  note right of Storage
    Write nine-field UTF-8 records
    to a temporary file.
  end note
  Storage -> Storage : moveIntoPlace(temporaryFile)
  note right of Storage
    Replace the activity file.
    Clear recovery and dirty flags after success.
  end note
  Storage --> Console
  deactivate Storage
end
note over Console, Storage
  If a save throws, keep unsavedChanges true and show a persistent warning.
  Bye retries unsaved changes before exit without modifying activities.
  A bye request is blocked until saving succeeds.
end note
note over Console, Mark
  Display the command result through Ui
  after any required save succeeds.
end note
Console -> UI : showMessage(result.getMessage())
UI --> User : confirmation or unchanged-state warning
@enduml
'@@author
