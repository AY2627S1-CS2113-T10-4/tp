'@@author Oliver-koh
@startuml
title Validate an activity name or schedule edit before saving
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ParticipantBackgroundColor #EDF3F8
skinparam ParticipantBorderColor #526477
skinparam ArrowColor #526477
skinparam sequenceMessageAlign center
hide footbox

participant "ConsoleHelper" as Console
participant "parser:Parser" as Parser
participant "activities:ActivityList" as Activities
participant "ActivityScheduleValidator" as Schedule
participant "storage:Storage" as Storage
participant "ui:Ui" as UI

Console -> Parser : parse(input)
activate Parser
note right of Parser
  Reject non-ASCII command words before dispatch.
end note
create participant ":EditCommandParser" as EditParser
Parser -> EditParser : EditCommandParser(clock)
Parser -> EditParser : parse(arguments)
activate EditParser
note right of EditParser
  Validate supplied syntax and field values.
  ActivityNameValidator requires printable-ASCII replacement names.
  Group supplied values in immutable Fields; null means omitted.
end note
create participant "changes:EditCommand.Fields" as Changes
EditParser -> Changes : Fields(name, date, start, end, demand, importance, urgency, commitment)
create participant ":EditCommand" as Edit
EditParser -> Edit : EditCommand(index, changes, clock, allowOverlap)
EditParser --> Parser : editCommand
deactivate EditParser
Parser --> Console : editCommand
deactivate Parser

Console -> Edit : execute(activities, storage)
activate Edit
Edit -> Activities : getByDisplayedIndex(displayedIndex)
activate Activities
Activities -> Activities : getCanonicalView()
Activities --> Edit : existingActivity
deactivate Activities
Edit -> Edit : LocalDateTime.now(clock)
note over Edit, Activities
  This success-path example assumes the original end is after now
  and any supplied date/time range ends after now.
  Combine supplied fields with existing values.
  Preserve completion and omitted ratings.
end note
create participant "replacement:Activity" as Replacement
Edit -> Replacement : Activity(...)
note over Edit, Schedule
  Name/schedule edits run schedule validation.
  Demand/rating-only edits skip it.
end note
opt name or schedule field supplied
  Edit -> Schedule : validate(replacement, activities, existingActivity, allowOverlap)
  Schedule -> Activities : getCanonicalView()
  Activities --> Schedule : chronological activities
end
alt duplicate or unapproved time clash
  Schedule --> Edit : throws UniEnableException(warning)
  Edit --> Console : propagate warning
  Console -> UI : showMessage(warning)
  opt unsaved changes remain
    Console -> Storage : hasUnsavedChanges()
    Storage --> Console : true
    Console -> UI : showMessage(persistent unsaved warning)
  end
else validation passes or is skipped
  opt validation was requested
    Schedule --> Edit : validation passed
  end
  Edit -> Activities : replaceByDisplayedIndex(displayedIndex, replacement)
  activate Activities
  Activities -> Activities : getByDisplayedIndex(displayedIndex)
  note right of Activities
    Replace the same chronological activity
    at its backing-list insertion position.
  end note
  Activities --> Edit
  deactivate Activities
  Edit --> Console : result (didChangeActivities = true)
  Console -> Storage : markUnsavedChanges()
  Console -> Storage : save(activities)
  alt save succeeds
    Storage --> Console : saved
    Console -> UI : showMessage(result.getMessage())
  else save fails
    Storage --> Console : throws UniEnableException
    Console -> UI : showMessage(save error)
    Console -> Storage : hasUnsavedChanges()
    Storage --> Console : true
    Console -> UI : showMessage(persistent unsaved warning)
  end
end
deactivate Edit

note over Console, UI
  ConsoleHelper, not EditCommand, marks and saves the mutation.
  Storage's serialization and recovery details are shown in CompletionAndSaveSequence.
  The omitted rejection path for ended activities or invalid resulting times
  throws before replacement and save. All rejected edits preserve activity data.
end note
@enduml
'@@author
