'@@author Oliver-koh
@startuml
!pragma layout smetana
title Activity editing design
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
skinparam ArrowColor #526477
hide empty members

abstract class Command {
  +execute(...): CommandResult
}
class Parser {
  -clock: Clock
  +parse(input: String): Command
}
class EditCommandParser {
  -clock: Clock
  +parse(arguments: String): EditCommand
}
class EditCommand {
  -displayedIndex: int
  -fields: Fields
  -clock: Clock
  +execute(...): CommandResult
}
class "EditCommand.Fields" as EditFields <<record>> {
  -name: String
  -date: LocalDate
  -startTime: LocalTime
  -endTime: LocalTime
  -demand: DemandLevel
  -importance: Integer
  -urgency: Integer
  -commitment: Integer
}
class ActivityParameterValidator <<package-private>> {
  {static} ~validate(arguments: String): void
}
class ActivityNameValidator <<package-private>> {
  {static} ~validate(name: String): void
}
class ActivityScheduleValidator <<package-private>> {
  {static} ~validate(...): void
}
class ActivityList {
  +getByDisplayedIndex(displayedIndex: int): Activity
  +replaceByDisplayedIndex(displayedIndex: int, replacement: Activity): void
  +getCanonicalView(): List<Activity>
}
class Activity {
  +isDone(): boolean
}
class CommandResult {
  +getMessage(): String
  +didChangeActivities(): boolean
}

Command <|-- EditCommand
Parser ..> EditCommandParser : delegates edit
EditCommandParser ..> EditCommand : creates with index, fields, clock and override
EditCommandParser ..> EditFields : groups supplied values
EditCommand --> EditFields : fields
EditCommandParser ..> ActivityNameValidator : checks supplied name safety
EditCommandParser ..> ActivityParameterValidator : rejects likely prefix typos
EditCommand ..> ActivityScheduleValidator : checks name / schedule edits
ActivityScheduleValidator ..> ActivityList : reads chronological view
EditCommand ..> ActivityList : resolves and replaces activity
EditCommand ..> Activity : constructs replacement
EditCommand ..> CommandResult : requests saving
ActivityList --> "0..*" Activity : activities

note bottom of EditCommand
  Fields is an immutable group of optional replacements.
  A null component means that field was omitted.
  Omitted fields and completion are preserved.
  Reject every edit when the original activity ends at or before now.
  Date/time edits validate the combined range before replacement.
  Name/schedule edits reject duplicates and unapproved clashes, excluding the original.
  Demand/rating-only edits skip schedule validation.
  Rejected edits do not replace or save the original activity.
end note
note bottom of CommandResult
  A successful edit sets didChangeActivities() to true.
  ConsoleHelper handles saving and displaying the result.
end note
@enduml
'@@author
