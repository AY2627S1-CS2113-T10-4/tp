'@@author Atharva005
@startuml
!pragma layout smetana
title Calendar dashboard design
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
skinparam ArrowColor #526477
hide empty members

abstract class Command {
  +execute(activities: ActivityList, storage: Storage): CommandResult
}
class Parser {
  -clock: Clock
  +parse(input: String): Command
}
class ViewCommand {
  -range: Range
  -clock: Clock
  +ViewCommand(range: Range, clock: Clock)
  +execute(activities: ActivityList, storage: Storage): CommandResult
  -format(start: LocalDate, end: LocalDate, view: List<Activity>): String
  {static} -appendDay(...): void
  {static} -appendSummary(...): void
  {static} -appendRatingChart(...): void
}
enum Range <<nested in ViewCommand>> {
  TODAY
  TOMORROW
  WEEK
}
class ActivityList {
  +getViewBetween(start: LocalDate, end: LocalDate): List<Activity>
  +getCanonicalView(): List<Activity>
}
class Activity {
  +getDate(): LocalDate
  +isDone(): boolean
  +getPriorityScore(): Integer
}
class CommandResult {
  +getMessage(): String
  +isExit(): boolean
  +didChangeActivities(): boolean
}

Command <|-- ViewCommand
Parser ..> ViewCommand : creates with session clock
ViewCommand --> Range : selected period
ViewCommand ..> ActivityList : inclusive date query
ViewCommand ..> Activity : reads details and ratings
ViewCommand ..> CommandResult : creates read-only result
ActivityList --> "0..*" Activity : activities

note bottom of Range
  TODAY: today only.
  TOMORROW: tomorrow only.
  WEEK: today through today + 6 days.
end note
note bottom of ViewCommand
  Completed activities remain included.
  An empty period returns a heading and warning only.
  Populated periods include an aligned rating table.
  Result flags: exit = false, changed = false.
end note
@enduml
'@@author
