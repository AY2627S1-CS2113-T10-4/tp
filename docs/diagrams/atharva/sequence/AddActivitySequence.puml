'@@author Atharva005
@startuml
title Add an activity
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ParticipantBackgroundColor #EDF3F8
skinparam ParticipantBorderColor #526477
skinparam ArrowColor #526477
skinparam sequenceMessageAlign center
hide footbox

participant "ConsoleHelper" as Console
participant "parser:Parser" as Parser
participant "activities:ActivityList" as Activities
participant "ActivityScheduleValidator" as Schedule
participant "ui:Ui" as UI

Console -> Parser : parse(input)
activate Parser
note right of Parser
  Reject non-ASCII command words before dispatch.
  This path assumes valid command syntax and fields.
end note
create participant ":AddCommandParser" as AddParser
Parser -> AddParser : AddCommandParser(clock)
Parser -> AddParser : parse(arguments)
activate AddParser
note right of AddParser
  Validate fields, date/time, and ratings.
  ActivityParameterValidator rejects likely prefix typos.
  ActivityNameValidator checks Unicode name safety.
  Default demand and unset ratings.
end note
create participant ":AddCommand" as Add
AddParser -> Add : AddCommand(...)
activate Add
create participant ":Activity" as Activity
Add -> Activity : Activity(..., false, 5, null, null)
activate Activity
Activity --> Add
deactivate Activity
Add --> AddParser
deactivate Add
AddParser --> Parser : addCommand
deactivate AddParser
Parser --> Console : addCommand
deactivate Parser

Console -> Add : execute(activities, storage)
activate Add
Add -> Schedule : validate(activity, activities, null, allowOverlap)
Schedule -> Activities : getCanonicalView()
Activities --> Schedule : chronological activities
alt duplicate activity or unapproved time clash
  Schedule --> Add : throws UniEnableException(warning)
  Add --> Console : propagate warning
  Console -> UI : showMessage(warning)
else no duplicate and any overlap is approved
  Schedule --> Add : validation passed
  Add -> Activities : addActivity(activity)
  activate Activities
  Activities --> Add
  deactivate Activities
  Add --> Console : result (didChangeActivities = true)
end
deactivate Add
note over Console, Activities
  Only successful insertion reaches the shared save-and-display steps.
  A rejected add changes neither the count nor the stored file.
  See CompletionAndSaveSequence.
end note
@enduml
'@@author
