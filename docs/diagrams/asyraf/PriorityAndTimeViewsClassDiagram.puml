@startuml
!pragma layout smetana
title Priority, overdue and next views
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
skinparam ArrowColor #526477
hide empty members

abstract class Command
class Parser {
  -clock: Clock
  +parse(input: String): Command
}
class ListDeleteCommandParser {
  +parseList(words: String[]): Command
}
class ListPriorityCommand
class OverdueCommand {
  -clock: Clock
}
class NextCommand {
  -clock: Clock
}
class Activity {
  +getPriorityScore(): Integer
}
class ActivityList {
  {static} -PRIORITY_ORDER: Comparator<Activity>
  +getCanonicalView(): List<Activity>
  +getPriorityView(): List<Activity>
  +getOverdueView(now: LocalDateTime): List<Activity>
  +getNext(now: LocalDateTime): Optional<Activity>
}
class ActivityListFormatter <<utility>> {
  {static} +formatPriorityList(...): String
  {static} +formatOverdueList(...): String
  {static} +formatNext(...): String
}

Command <|-- ListPriorityCommand
Command <|-- OverdueCommand
Command <|-- NextCommand
Parser ..> ListDeleteCommandParser : delegates list
ListDeleteCommandParser ..> ListPriorityCommand : creates
Parser ..> OverdueCommand : creates with clock
Parser ..> NextCommand : creates with clock
ListPriorityCommand ..> ActivityList : priority view
OverdueCommand ..> ActivityList : overdue view
NextCommand ..> ActivityList : next activity
ListPriorityCommand ..> ActivityListFormatter
OverdueCommand ..> ActivityListFormatter
NextCommand ..> ActivityListFormatter
ActivityList --> "0..*" Activity : activities / scores

note bottom of ActivityList
  Priority includes completed activities.
  Time views include incomplete activities only.
  Commands obtain the full canonical view for row indexes.
end note
@enduml
