'@@author lukelouyu
@startuml
!pragma layout smetana
title Command and Unicode activity name validation
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
skinparam ArrowColor #526477
hide empty members

class Parser {
  +parse(input: String): Command
}
class AddCommandParser {
  +parse(arguments: String): AddCommand
}
class EditCommandParser {
  +parse(arguments: String): EditCommand
}
class ActivityParameterValidator <<package-private>> {
  ~{static} validate(arguments: String): void
}
class ActivityNameValidator <<package-private>> {
  ~{static} validate(name: String): void
}
class ParseException <<checked exception>>

Parser ..> AddCommandParser : dispatches add
Parser ..> EditCommandParser : dispatches edit
Parser ..> ParseException : rejects non-ASCII command words
AddCommandParser ..> ActivityNameValidator : checks required name
EditCommandParser ..> ActivityNameValidator : checks supplied name
AddCommandParser ..> ActivityParameterValidator : checks field spelling
EditCommandParser ..> ActivityParameterValidator : checks field spelling
ActivityParameterValidator ..> ParseException : rejects likely prefix typos
ActivityNameValidator ..> ParseException : rejects controls / malformed surrogates

note top of Parser
  Check the command word before case conversion.
  Report: Please write the command in English.
  Find keywords may still match saved Unicode names.
end note

note bottom of ActivityNameValidator
  Unicode names are accepted, including accents, Chinese, Tamil, and emoji.
  Reject control characters and malformed UTF-16 surrogates.
  Parsers keep blank-name and delimiter checks.
  Storage reads and writes names as UTF-8.
end note
@enduml
'@@author
