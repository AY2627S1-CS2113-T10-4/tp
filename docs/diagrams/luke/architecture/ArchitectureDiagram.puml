'@@author lukelouyu
@startuml
!pragma layout smetana

title UniEnable architecture
top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam componentStyle rectangle
skinparam componentBackgroundColor #EDF3F8
skinparam componentBorderColor #526477
skinparam ArrowColor #526477
skinparam nodesep 45
skinparam ranksep 50

component "Application\nUniEnable / ConsoleHelper" as Console
component "Terminal UI\nUi / output formatters" as UI
component "Parsing\nParser / command parsers" as Parsing
component "Commands\nCommand / CommandResult / feature commands" as Commands
component "Storage\nStorage / FacilityStorage / ConnectionStorage" as Storage
component "Accessibility logic\nFacilityManager / ConnectionManager\nDijkstraShortestPath / DijkstraSolver" as Accessibility
component "Models\nActivityList / Activity\nFacility / FacilityFeature / Connection" as Models

Console ..> UI : read / display
Console ..> Parsing : parse input
Console ..> Commands : execute
Console ..> Storage : load / save changes / retry on exit
Parsing ..> Commands : create
Commands ..> Models : read / update activities
Commands ..> Accessibility : query
Commands ..> UI : format list and facility results
Accessibility ..> Models : read reference data
Storage ..> Models : load records / save activities

@enduml
'@@author
