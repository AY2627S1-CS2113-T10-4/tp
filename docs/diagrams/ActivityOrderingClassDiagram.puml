@startuml
!pragma layout smetana
title Ordering and displayed indexes
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
skinparam ArrowColor #526477
hide empty members

abstract class Command
class ListCommand
class ListDemandCommand
class DeleteCommand {
  -displayedIndex: int
}
class ActivityList {
  {static} -CANONICAL_ORDER: Comparator<Activity>
  {static} -DEMAND_ORDER: Comparator<Activity>
  +getCanonicalView(): List<Activity>
  +getDemandView(): List<Activity>
  +deleteByDisplayedIndex(displayedIndex: int): Activity
}
class ActivityListFormatter <<utility>> {
  {static} +formatList(...): String
  {static} +formatDemandList(...): String
}
class Activity

Command <|-- ListCommand
Command <|-- ListDemandCommand
Command <|-- DeleteCommand
ListCommand ..> ActivityList : canonical view
ListDemandCommand ..> ActivityList : demand view
DeleteCommand ..> ActivityList : canonical index
ListCommand ..> ActivityListFormatter : formatList(...)
ListDemandCommand ..> ActivityListFormatter : formatDemandList(...)
ActivityList --> "0..*" Activity : activities

note bottom of ActivityList
  The backing list keeps insertion order.
  Display views are separate unmodifiable lists.
end note
@enduml
